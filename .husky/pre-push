#!/bin/sh
# Git passes one "<local ref> <local sha> <remote ref> <remote sha>" line per
# pushed ref on stdin. Block direct pushes by destination, and run the fast checks only
# when a branch with commits is pushed (not for tags or branch deletions, whose
# local sha is all zeros).
needs_verify=false
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/master | refs/heads/develop)
      echo "Error: Direct pushes to '${remote_ref#refs/heads/}' are not allowed. Please use a feature branch and create a Pull Request."
      exit 1
      ;;
    refs/tags/*) continue ;;
  esac
  case "$local_sha" in
    *[!0]*) needs_verify=true ;;
  esac
done

if [ "$needs_verify" = true ]; then
  npm run typecheck && npm run lint:check
fi
