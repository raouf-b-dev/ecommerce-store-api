# GitHub Actions repository secrets (Settings → Secrets and variables → Actions)
# Generate local values: npm run env:init:secrets -- --overwrite
# Then copy from .secrets into GitHub — do not commit .secrets

CI_DB_USERNAME=example
CI_DB_PASSWORD=example
CI_DB_DATABASE=example
CI_REDIS_PASSWORD=example
CI_REDIS_KEYPREFIX=ecom:test:
# RSA-4096 PKCS#8 PEM, base64-encoded — generated by npm run env:init:secrets
CI_JWT_PRIVATE_KEY=
# Hex key for /metrics smoke probe in CI
CI_METRICS_API_KEY=
