NODE_ENV=example
# Canonical API port. Prometheus scrapes host.docker.internal:$PORT.
# If Windows Hyper-V reserves 3000-3199, change PORT here (or in the generated
# .env.*) and keep CORS_ALLOWED_ORIGINS / OTEL_EXPORTER_OTLP_ENDPOINT in sync.
PORT=3000
APP_VERSION=""

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_INSIGHT_PORT=8001
REDIS_PASSWORD=secret
REDIS_KEYPREFIX=ecom:example:
REDIS_DB=0
REDIS_CONTAINER_NAME=redis-stack
REDIS_IMAGE=redis/redis-stack:7.2.0-v18
# Set true for managed Redis that requires TLS (rediss). Leave false for Compose.
REDIS_TLS=false

# DB CONFIG // Warning: Turn this off in production
IS_DB_SYNCHRONIZE=false

JWT_PRIVATE_KEY="<paste-your-rsa-pem>"
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_DATABASE=my_database
# Set true for managed Postgres that requires SSL. Leave false for Compose.
DB_SSL=false
# When DB_SSL=true, verify the server certificate (set false only for self-signed).
DB_SSL_REJECT_UNAUTHORIZED=true
# Docker Compose / backup scripts only; optional for PaaS deploys (defaults apply).
POSTGRES_CONTAINER_NAME=postgres-db
POSTGRES_IMAGE=postgres:18.4

# Must include the API origin for the chosen PORT, plus local frontends
# (admin Vite 5173/5174, storefront Next 3100). Credentials CORS; do not use *.
# Each entry must be a valid http(s) origin (validated at startup).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100,http://localhost:5173,http://localhost:5174

# Logging
LOG_LEVEL=info
LOG_DIR=./logs
LOG_TRANSPORT=both

# Rate Limiting (Throttler)
# Global default profile applied to all routes (requests per 60s window).
THROTTLE_GLOBAL_LIMIT=100
# Documented target for auth credential limits. Auth @Throttle values live in
# src/infrastructure/throttler/throttle.constants.ts (AUTH_STRICT_LIMIT=10).
THROTTLE_STRICT_LIMIT=10

# Reverse proxy hop count / trust (false | true | 1 | 2 | subnet list)
TRUST_PROXY=false

# Required. Origin browsers use to reach this API (scheme + host + optional port, no path).
# The demo seed stores product photo URLs as <PUBLIC_BASE_URL>/media/demo/v1/<sku>.webp.
# Keep in sync with PORT locally. env:init leaves it blank for staging/production so
# the API refuses to start until the real public origin is set; there it must be https
# (loopback hosts excepted for local production-mode runs).
PUBLIC_BASE_URL=http://localhost:3000

# Metrics
METRICS_API_KEY=super-secret-metrics-key
# Prometheus scrapes host.docker.internal:$PORT (entrypoint renders the scrape target).
PROMETHEUS_HOST_PORT=9090

# OpenTelemetry
# Local DX defaults on. Staging/production env:init sets false unless a collector exists.
OTEL_TRACING_ENABLED=true
# Must match OTLP_GRPC_HOST_PORT.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTLP_GRPC_HOST_PORT=4317
OTLP_HTTP_HOST_PORT=4318
TEMPO_HOST_PORT=3200

# Swagger UI at /api/docs. Omitted/false = off (production-safe). env:init sets true for
# development/staging/test and false for production; production rejects true at boot.
SWAGGER_ENABLED=true

# Grafana (Monitoring Stack)
GRAFANA_ADMIN_USER=admin_user
GRAFANA_ADMIN_PASSWORD=secure_password
# Host publish ports. Defaults can fail on Windows Hyper-V (3000-3199 reserved);
# edit these values in this file (or the generated .env.*) if bind fails.
GRAFANA_HOST_PORT=3001
LOKI_HOST_PORT=13100

# Payments (mock Stripe adapter)
# When true, checkouts auto-schedule a delayed simulated webhook so orders
# leave pending_payment without a real Stripe callback. Enabled for development
# and staging demo via env:init; keep false in test/production.
PAYMENT_MOCK_AUTO_COMPLETE=false

# Stripe webhook signing secret (whsec_..., required in production and staging,
# find it in the Stripe dashboard or stripe listen).
STRIPE_WEBHOOK_SECRET=

# Store Currency Configuration
# Single authoritative store currency (ISO 4217 code with 0-3 decimal places, e.g. USD, JPY, KWD). Validated at startup.
# Production policy: must be explicitly configured; changing this does not convert historical
# order snapshots, payment records, or open carts.
STORE_DEFAULT_CURRENCY=USD
