NODE_ENV=example
# Canonical API port. Prometheus scrapes host.docker.internal:$PORT.
# If Windows Hyper-V reserves 3000-3199, change PORT here (or in the generated
# .env.*) and keep CORS_ALLOWED_ORIGINS / OTEL_EXPORTER_OTLP_ENDPOINT in sync.
PORT=3000
APP_VERSION=""

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=secret
REDIS_KEYPREFIX=ecom:example:
REDIS_DB=0
REDIS_CONTAINER_NAME=redis-stack
REDIS_IMAGE=redis/redis-stack:7.2.0-v18

# DB CONFIG // Warning: Turn this off in production
IS_DB_SYNCHRONIZE=false

JWT_PRIVATE_KEY="<paste-your-rsa-pem>"
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_DATABASE=my_database
POSTGRES_CONTAINER_NAME=postgres-db
POSTGRES_IMAGE=postgres:18.4

# Must include the API origin for the chosen PORT, plus local frontends.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Logging
LOG_LEVEL=info
LOG_DIR=./logs
LOG_TRANSPORT=both

# Rate Limiting (Throttler)
# Global default profile applied to all routes (requests per 60s window).
THROTTLE_GLOBAL_LIMIT=100
# Documented target for auth credential limits. Auth @Throttle values live in
# src/infrastructure/throttler/throttle.constants.ts (AUTH_STRICT_LIMIT=10).
THROTTLE_STRICT_LIMIT=10

# Reverse proxy hop count / trust (false | true | 1 | 2 | subnet list)
TRUST_PROXY=false

# Metrics
METRICS_API_KEY=super-secret-metrics-key
# Prometheus scrapes host.docker.internal:$PORT (entrypoint renders the scrape target).
PROMETHEUS_HOST_PORT=9090

# OpenTelemetry
OTEL_TRACING_ENABLED=true
# Must match OTLP_GRPC_HOST_PORT.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTLP_GRPC_HOST_PORT=4317
OTLP_HTTP_HOST_PORT=4318
TEMPO_HOST_PORT=3200

# Grafana (Monitoring Stack)
GRAFANA_ADMIN_USER=admin_user
GRAFANA_ADMIN_PASSWORD=secure_password
# Host publish ports. Defaults can fail on Windows Hyper-V (3000-3199 reserved);
# edit these values in this file (or the generated .env.*) if bind fails.
GRAFANA_HOST_PORT=3001
LOKI_HOST_PORT=3100
